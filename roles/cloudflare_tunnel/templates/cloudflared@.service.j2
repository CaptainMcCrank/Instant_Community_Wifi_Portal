[Unit]
Description=Cloudflare Tunnel for %i
After=network.target
Wants=network-online.target

[Service]
Type=simple
User={{ cloudflare_tunnel.user }}
Group={{ cloudflare_tunnel.group }}
ExecStart={{ cloudflare_tunnel.binary_path }} tunnel --config {{ cloudflare_tunnel.config_dir }}/config.yml run
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cloudflared-%i

# Security settings
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=no
ReadWritePaths={{ cloudflare_tunnel.config_dir }} /home/{{ cloudflare_tunnel.user }}/.cloudflared

[Install]
WantedBy=multi-user.target 