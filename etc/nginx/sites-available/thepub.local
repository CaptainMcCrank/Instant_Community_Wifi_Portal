server {
	listen 80;
	server_name thepub.local www.thepub.local bidding-sought-tongue-essex.trycloudflare.com selfies.griffincreektrestle.net;
	access_log /var/log/nginx/access.log combined;
	error_log /var/log/nginx/error.log warn;
	client_max_body_size 28M;

        location /selfies/static/ {
        	alias /var/www/thepub.local/apps/selfies/static/;
        	expires 1d;
        	add_header Cache-Control "public, immutable";
        	try_files $uri =404;
    	}
    	
	# Serve uploaded images directly
    	location /selfies/data/uploads/ {
        	alias /var/www/thepub.local/apps/selfies/data/uploads/;
        	expires 1d;
        	add_header Cache-Control "public, immutable";
    	}

    	# Selfie portal location (proxy everything else to Flask)
	#location /selfies {
    	location / {
        	proxy_pass http://127.0.0.1:5001;
        	proxy_set_header Host $host;
        	proxy_set_header X-Real-IP $remote_addr;
        	proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
		proxy_set_header X-Forwarded-Proto http;

        # Handle large file uploads
        client_max_body_size 10M;
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }

    root /var/www/thepub.local/sites/$host/;
    index index.html;

    #location / {
	    #try_files $uri @werc;
	#}
    location /pub/ {
        root /var/www/thepub.local;
        try_files $uri =404;
    }
    location = /favicon.ico {
        root /var/www/thepub.local;
        try_files /var/www/thepub.local/sites/$host/$uri /pub/default_favicon.ico =404;
    }

    error_page 404 = @werc;

    location @werc {
        include fastcgi_params;
        fastcgi_pass localhost:3333;
    }
}

