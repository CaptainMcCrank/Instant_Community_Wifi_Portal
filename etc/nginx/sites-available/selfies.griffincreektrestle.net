server {
    listen 80;
    listen 443 ssl http2;
    server_name selfies.griffincreektrestle.net;
    
    # SSL configuration for Cloudflare certificate approach
    # Note: This uses self-signed certs locally, but Cloudflare provides valid certs to clients
    ssl_certificate /etc/ssl/certs/ssl-cert-snakeoil.pem;
    ssl_certificate_key /etc/ssl/private/ssl-cert-snakeoil.key;

    access_log /var/log/nginx/selfies.access.log;
    error_log /var/log/nginx/selfies.error.log;

    client_max_body_size 10M;

    # Serve static files directly
    location /static/ {
        alias /var/www/ansibledest.local/apps/selfies/static/;
        expires 1d;
        add_header Cache-Control "public, immutable";
        try_files $uri =404;
    }
    
    # Serve uploaded images directly
    location /data/uploads/ {
        alias /var/www/ansibledest.local/apps/selfies/data/uploads/;
        expires 1d;
        add_header Cache-Control "public, immutable";
    }

    # Proxy everything else to Flask app
    location / {
        proxy_pass http://127.0.0.1:5001;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # Handle large file uploads
        proxy_read_timeout 300s;
        proxy_connect_timeout 75s;
    }
} 